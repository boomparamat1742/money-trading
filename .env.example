# ── Exchange ─────────────────────────────────────────────
EXCHANGE=binance                 # binance | bybit
SYMBOLS=BTCUSDT                  # comma-separated
PRIMARY_TIMEFRAME=15m
CONFIRM_TIMEFRAME=1h

# ── Claude (AI Context Service — slow path only) ─────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5         # claude-opus-5 | claude-haiku-4-5
AI_ENABLED=true                  # false → system runs Quant-only

# ── News ─────────────────────────────────────────────────
NEWS_PROVIDER=cryptopanic        # cryptopanic | newsapi | finnhub
NEWS_API_KEY=

# ── Persistence / cache ─────────────────────────────────
# ── ฐานข้อมูล ────────────────────────────────────────────
# ไม่ใส่ DATABASE_URL = ใช้ SQLite ในเครื่อง (ไม่ต้องตั้งค่าอะไร)
# ใส่ DATABASE_URL   = ใช้ Supabase/Postgres (รัน migrations/supabase.sql ก่อน)
#
# Supabase: Project Settings → Database → Connection string → URI
#   ใช้ "Session pooler" (port 5432) สำหรับ worker ที่รันยาว
#   หรือ "Transaction pooler" (port 6543) สำหรับงานสั้นๆ
#   อย่าลืมแทน [YOUR-PASSWORD] ด้วยรหัสจริง
DATABASE_URL=
JOURNAL_DB=data/journal.db       # ใช้เมื่อเป็น SQLite
EDGE_LAB_DB=data/edge_lab.db     # ใช้เมื่อเป็น SQLite
REDIS_URL=                       # redis://... (Upstash)

# ── Notifications ────────────────────────────────────────
# LINE Messaging API (LINE Notify is discontinued). Create a Messaging API
# channel in the LINE Developers Console → get the Channel access token, and
# the destination id (your userId, or a groupId the bot has joined).
LINE_CHANNEL_TOKEN=
# ปลายทาง: userId (แชทเดี่ยว), groupId (กลุ่ม), หรือ roomId (แชทหลายคน)
# groupId หาได้จาก:  python -m scripts.line_get_group_id  (ดักจาก webhook)
LINE_TO=
# จำกัดจำนวนข้อความ/วัน (กันโควตา LINE free tier หมด)
NOTIFY_MAX_PER_DAY=20
# (optional) Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Risk policy (Hard-coded guards) ─────────────────────
ACCOUNT_EQUITY=10000             # paper equity, quote currency
RISK_PER_TRADE_PCT=0.5           # % of equity risked per trade
MIN_REWARD_RISK=1.5
MAX_OPEN_TRADES=3
DAILY_LOSS_LIMIT_PCT=3.0
MAX_CONSECUTIVE_LOSSES=4
SIGNAL_SCORE_THRESHOLD=65        # min score to act
KILL_SWITCH=false                # true → block all new trades

# Leverage suggestion (Binance Futures, Isolated) — for the LINE alert
LEVERAGE_CAP=10                  # เพดาน leverage สูงสุดที่จะแนะนำ
LIQ_BUFFER=2.0                   # liquidation ต้องไกลกว่า SL อย่างน้อยกี่เท่า

# ── Cost control (Budget guard) ─────────────────────────
AI_DAILY_CALL_LIMIT=50
AI_DAILY_COST_LIMIT_USD=2
NEWS_DAILY_CALL_LIMIT=500
MAX_SYMBOLS=3

# ── Fees / slippage (paper trading realism) ─────────────
TAKER_FEE_PCT=0.05               # per side
SLIPPAGE_PCT=0.02
